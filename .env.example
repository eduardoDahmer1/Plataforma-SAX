APP_NAME=SAX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Monitor do integrador de produtos (o mesmo token deve ser configurado no integrador)
INTEGRATION_MONITOR_TOKEN=
INTEGRATION_FAILURE_ALERT_AFTER_MINUTES=1440
INTEGRATION_EMAIL_ALERTS_ENABLED=true

# Sincronização bidirecional do catálogo óptico entre loja normal e Ótica.
# Em plataforma: peer database=plataforma_otica e storage=/var/www/html/sax_otica/storage/app/public
# Em Ótica: peer database=plataforma e storage=/var/www/html/sax_plataforma/storage/app/public
CATALOG_PEER_SYNC_ENABLED=false
CATALOG_PEER_DB_HOST=127.0.0.1
CATALOG_PEER_DB_PORT=3306
CATALOG_PEER_DB_DATABASE=
CATALOG_PEER_DB_USERNAME=
CATALOG_PEER_DB_PASSWORD=
CATALOG_PEER_STORAGE_PATH=
CATALOG_OPTICAL_CATEGORY_REF_CODE=13
CATALOG_OPTICAL_CATEGORY_SLUGS=optico,otica
CATALOG_OPTICAL_DATABASE_NAMES=plataforma_otica

# Generación de propuestas de catálogo con OpenAI (no guardar la clave en el repositorio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_CATALOG_REASONING_EFFORT=medium
OPENAI_CATALOG_SEARCH_CONTEXT_SIZE=high
OPENAI_TIMEOUT=90
OPENAI_MAX_OUTPUT_TOKENS=3000

# GeoNames: países, estados/províncias e cidades internacionais
GEONAMES_USERNAME=
GEONAMES_BASE_URL=https://secure.geonames.org
GEONAMES_TIMEOUT=12

# País aproximado dos visitantes anônimos (o IP bruto não é armazenado).
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_URL="https://ipwho.is/{ip}?fields=success,country,country_code"
IP_GEOLOCATION_TIMEOUT=2

# DHL Express MyDHL API (credenciais somente no ambiente/secret manager)
DHL_ENABLED=false
DHL_ENVIRONMENT=sandbox
DHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_TIMEOUT=20
DHL_RETRY_TIMES=2
DHL_CURRENCY=USD
DHL_UNIT_OF_MEASUREMENT=metric
DHL_DUTIES_TAXES_PAYER=receiver
DHL_INCOTERM=DAP
DHL_EXCLUDED_COUNTRY_CODES=PY
DHL_VOLUMETRIC_DIVISOR=5000
DHL_RATE_MARKUP_PERCENT=5
DHL_RATE_MARKUP_ENABLED=true
DHL_FALLBACK_MEASUREMENTS_ENABLED=true
DHL_FREE_SHIPPING_ENABLED=false
DHL_FREE_SHIPPING_MIN_ITEMS=3
DHL_FREE_SHIPPING_MIN_SUBTOTAL=
DHL_FREE_SHIPPING_MAX_BILLABLE_WEIGHT_KG=1
DHL_ORIGIN_COUNTRY_CODE=PY
DHL_ORIGIN_POSTAL_CODE=
DHL_ORIGIN_CITY=Ciudad del Este
DHL_ORIGIN_PROVINCE_CODE=
DHL_ORIGIN_PROVINCE_NAME=
DHL_ORIGIN_DISTRICT=
DHL_ORIGIN_ADDRESS_LINE_1=
DHL_ORIGIN_ADDRESS_LINE_2=
DHL_ORIGIN_COMPANY_NAME=
DHL_ORIGIN_TRADING_NAME=SAX Department Store
DHL_ORIGIN_TAX_ID=
DHL_ORIGIN_CONTACT_NAME=
DHL_ORIGIN_PHONE=
DHL_ORIGIN_EMAIL=
